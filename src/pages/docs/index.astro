---
// src/pages/docs/index.astro
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const quickServer = `
const { Server } = require('@afterlink/server');

// Fire up binary server
const server = new Server({ port: 8080 });

// Handle frame connections
server.on('message', (socket, frame) => {
  console.log(\`Received frame type #\${frame.type} with \${frame.length} bytes payload\`);
  
  // Acknowledge back
  server.send(socket, 'ACK', { status: 'OK' });
});
`;

const quickClient = `
const { Client } = require('@afterlink/client');

// Connect to AfterLink TCP daemon
const client = new Client({ port: 8080 });

client.on('connect', () => {
  console.log('Socket channel ready');
  
  // Publish payload to 'sensor-stream' pubsub channel
  client.send('PUBLISH', {
    channel: 'sensor-stream',
    payload: { temperature: 21.4 }
  });
});
`;
---

<DocsLayout 
  title="Getting Started with AfterLink" 
  description="Learn how to install, set up, and configure persistent, binary-precise AfterLink server and client communication."
  schema={{
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": "Getting Started with AfterLink",
    "description": "Learn how to install, set up, and configure persistent, binary-precise AfterLink server and client communication.",
    "author": { "@type": "Person", "name": "Javali Ajayakumar" },
    "publisher": { "@type": "Organization", "name": "AfterLink" },
    "mainEntityOfPage": "https://afterlink-docs.vercel.app/docs"
  }}
>
  <div class="space-y-6">
    <div class="border-b border-al-border/50 pb-4">
      <h1 class="text-3xl font-bold tracking-tight text-al-white mb-2">Getting Started</h1>
      <p class="text-sm text-al-muted leading-relaxed">
        AfterLink is a high-performance application-layer binary protocol engineered for persistent, real-time node communication. Learn how to configure a persistent server and client connection with built-in speed.
      </p>
    </div>

    <!-- Features intro list -->
    <div class="bg-al-dark/30 border border-al-border rounded-lg p-6 my-6">
      <h2 class="font-mono text-xs font-bold text-al-cyan uppercase tracking-wider mb-3">Why AfterLink?</h2>
      <ul class="space-y-2.5 text-xs text-al-text">
        <li class="flex items-start gap-2 select-all">
          <span class="text-al-cyan font-bold font-mono select-none">●</span>
          <strong>76% Faster than WebSockets:</strong> Streamlined binary framing reduces TCP wire transmission latencies to a bare minimum.
        </li>
        <li class="flex items-start gap-2 select-all">
          <span class="text-al-cyan font-bold font-mono select-none">●</span>
          <strong>90% Less Wire Overhead:</strong> A fixed 10-byte header format eliminates heavy HTTP header transport bloat.
        </li>
        <li class="flex items-start gap-2 select-all">
          <span class="text-al-cyan font-bold font-mono select-none">●</span>
          <strong>Built-in Pub/Sub Engine:</strong> Broadcast real-time frames directly from the protocol layer without external brokers.
        </li>
      </ul>
    </div>

    <!-- Prerequisites -->
    <h2 id="prerequisites" class="text-lg font-semibold tracking-tight text-al-white mt-10 mb-3 select-none">Prerequisites</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      Ensure your local environment matches the requirements before starting implementation:
    </p>
    <ul class="list-disc pl-5 space-y-1.5 text-xs text-al-muted select-all">
      <li>Node.js version <code>v18.0.0</code> or higher</li>
      <li>npm, pnpm, or yarn package manager</li>
    </li>

    <!-- Installation -->
    <h2 id="installation" class="text-lg font-semibold tracking-tight text-al-white mt-10 mb-3 select-none">Installation</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all mb-4">
      Install the standard AfterLink scoped packages from the npm registry:
    </p>
    <CodeBlock code="npm install @afterlink/core @afterlink/server @afterlink/client @afterlink/browser @afterlink/cli" lang="bash" filename="Terminal" />

    <!-- Server Quick Start -->
    <h2 id="quick-start-server" class="text-lg font-semibold tracking-tight text-al-white mt-10 mb-3 select-none">Quick Start — Server</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      Create a server script in your project root to handle binary framing:
    </p>
    <CodeBlock code={quickServer} lang="javascript" filename="server.js" />

    <!-- Client Quick Start -->
    <h2 id="quick-start-client" class="text-lg font-semibold tracking-tight text-al-white mt-10 mb-3 select-none">Quick Start — Client</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      Establish a persistent connection from your client and publish your first frame:
    </p>
    <CodeBlock code={quickClient} lang="javascript" filename="client.js" />

    <!-- First Message explanation -->
    <h2 id="next-steps" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-4 select-none">Next Steps</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
      <a href="/docs/installation" class="block p-4 rounded-lg border border-al-border hover:border-al-cyan/40 bg-al-card/20 transition-all select-none">
        <h3 class="font-mono text-xs font-bold text-al-cyan mb-1">Package Installation &rarr;</h3>
        <p class="text-3xs text-al-muted">Explore modular package distributions and setups.</p>
      </a>
      <a href="/docs/protocol" class="block p-4 rounded-lg border border-al-border hover:border-al-cyan/40 bg-al-card/20 transition-all select-none">
        <h3 class="font-mono text-xs font-bold text-al-cyan mb-1">Binary Protocol Spec &rarr;</h3>
        <p class="text-3xs text-al-muted">Deep dive into the 10-byte header format.</p>
      </a>
    </div>

    <!-- Prev/Next Navigation -->
    <div class="flex justify-between items-center mt-16 pt-6 border-t border-al-border">
      <span></span>
      <a href="/docs/installation" class="group flex items-center gap-2 text-sm font-mono text-al-muted hover:text-al-cyan transition-colors">
        <span>Installation</span>
        <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
      </a>
    </div>
  </div>
</DocsLayout>
