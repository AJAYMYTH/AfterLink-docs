---
// src/pages/docs/installation.astro
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const npmInstall = `
# Install standard AfterLink scoped packages via npm
npm install @afterlink/core @afterlink/server @afterlink/client @afterlink/cluster @afterlink/browser @afterlink/cli
`;

const pnpmInstall = `
# Install standard AfterLink scoped packages via pnpm
pnpm add @afterlink/core @afterlink/server @afterlink/client @afterlink/cluster @afterlink/browser @afterlink/cli
`;

const yarnInstall = `
# Install standard AfterLink scoped packages via yarn
yarn add @afterlink/core @afterlink/server @afterlink/client @afterlink/cluster @afterlink/browser @afterlink/cli
`;

const clusterInstall = `
# Install AfterLink Node clustering package
npm install @ajaymyth/cluster
`;

const pythonInstall = `
# Install Python SDK from PyPI
pip install afterlink
`;

const dartInstall = `
# Install Dart SDK from pub.dev
dart pub add afterlink

# Or for Flutter projects:
flutter pub add afterlink
`;

const githubNpmrc = `
# .npmrc configuration to route the @ajaymyth scope to GitHub Packages
@ajaymyth:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=YOUR_PAT
`;

const githubInstall = `
# Install a scoped package from GitHub Packages
npm install @ajaymyth/server @ajaymyth/cluster
`;

const modularInstall = `
# Core binary codec only (no network server)
npm install @afterlink/core

# Server, client, and clustering modules for Node
npm install @afterlink/server @afterlink/client @afterlink/cluster

# Client SDK for web browsers
npm install @afterlink/browser
`;

const quickServer = `
const { Server } = require('@afterlink/server');

// Fire up binary server
const server = new Server({ port: 8080 });

// Handle frame connections
server.on('message', (socket, frame) => {
  console.log(\`Received frame type #\${frame.type} with \${frame.length} bytes payload\`);
  
  // Acknowledge back
  server.send(socket, 'ACK', { status: 'OK' });
});
`;

const quickClient = `
const { Client } = require('@afterlink/client');

// Connect to AfterLink TCP daemon
const client = new Client({ port: 8080 });

client.on('connect', () => {
  console.log('Socket channel ready');
  
  // Publish payload to 'sensor-stream' pubsub channel
  client.send('PUBLISH', {
    channel: 'sensor-stream',
    payload: { temperature: 21.4 }
  });
});
`;

const cliInstall = `
# Install AfterLink development inspector globally
npm install -g @afterlink/cli
`;

const cdnScript = `
<!-- Load client SDK directly in html files via CDN fallback -->
<script src="https://unpkg.com/@afterlink/browser@2.0.2/dist/index.global.js"></script>
<script>
  const client = AfterLinkBrowser.createClient({ host: '127.0.0.1', port: 4000 });
</script>
`;

const tsConfigCode = `
{
  "compilerOptions": {
    "moduleResolution": "node",
    "paths": {
      "@afterlink/*": ["./node_modules/@afterlink/*"],
      "@ajaymyth/*": ["./node_modules/@ajaymyth/*"]
    }
  }
}
`;

const aiAssistantInstall = `
# Install globally
npm install -g @afterlink/ai-assistant
afterlink-ai
`;
---

<DocsLayout 
  title="Install AfterLink v2.0.2 — Setup Guide" 
  description="Install AfterLink v2.0.2 via npm, pip, or pub. Set up server, client, cluster, Python, Dart, browser, and CLI packages for binary protocol communication."
  schema={{
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": "Install AfterLink v2.0.2 — Setup Guide",
    "description": "Install AfterLink v2.0.2 via npm, pip, or pub. Set up server, client, cluster, Python, Dart, browser, and CLI packages for binary protocol communication.",
    "author": { "@type": "Person", "name": "Javali Ajayakumar" },
    "publisher": { "@type": "Organization", "name": "AfterLink" },
    "mainEntityOfPage": "https://afterlink-docs.vercel.app/docs/installation"
  }}
>
  <div class="space-y-6">
    <div class="border-b border-al-border/50 pb-4">
      <h1 class="text-3xl font-bold tracking-tight text-al-white mb-2">Package Installation</h1>
      <p class="text-sm text-al-muted leading-relaxed">
        AfterLink v2.0.2 is designed with strict modularity in mind. You can install the monolith package, pull individual libraries for Node.js, Python, or Dart, or load browser wrappers to fit your production stack footprint.
      </p>
    </div>

    <!-- Requirements -->
    <h2 id="requirements" class="text-lg font-semibold tracking-tight text-al-white mt-8 mb-3 select-none font-mono">System Requirements</h2>
    <ul class="list-disc pl-5 space-y-1.5 text-xs text-al-muted select-all">
      <li><strong>Node.js:</strong> version <code>v18.0.0</code> or higher (v20+ LTS recommended)</li>
      <li><strong>Python:</strong> version <code>3.8+</code> (for Python SDK)</li>
      <li><strong>Dart / Flutter:</strong> Dart <code>3.0+</code> / Flutter <code>3.0+</code> (for Dart SDK)</li>
      <li><strong>npm:</strong> version <code>v9.0.0</code> or higher</li>
      <li><strong>Operating System:</strong> Linux, macOS, or Windows (WSL recommended)</li>
    </ul>

    <!-- Two Distribution Channels -->
    <h2 id="distribution-channels" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none font-mono">1. Distribution Channels</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      AfterLink packages are published to two separate registries. Choose the channel that best suits your deployment environment.
    </p>

    <!-- Registry 1: npm (Standard) -->
    <h3 class="text-sm font-semibold text-al-white mt-6 mb-2">Registry 1: npm (Standard / Recommended)</h3>
    <p class="text-xs text-al-muted leading-relaxed mb-4">
      The standard release packages are published on the public npm registry under the official <code>@afterlink/*</code> scope. You can install all key modules in one command using your preferred package manager:
    </p>

    <div class="space-y-4">
      <div>
        <span class="text-3xs font-mono uppercase tracking-wider text-al-muted block mb-1">npm</span>
        <CodeBlock code={npmInstall} lang="bash" filename="Terminal" />
      </div>
      <div>
        <span class="text-3xs font-mono uppercase tracking-wider text-al-muted block mb-1">pnpm</span>
        <CodeBlock code={pnpmInstall} lang="bash" filename="Terminal" />
      </div>
      <div>
        <span class="text-3xs font-mono uppercase tracking-wider text-al-muted block mb-1">yarn</span>
        <CodeBlock code={yarnInstall} lang="bash" filename="Terminal" />
      </div>
    </div>

    <!-- Registry 2: GitHub Packages (Alternative) -->
    <h3 class="text-sm font-semibold text-al-white mt-8 mb-2">Registry 2: GitHub Packages (Alternative)</h3>
    <p class="text-xs text-al-muted leading-relaxed mb-4">
      As an alternative distribution channel, packages are also published to GitHub Packages under the <code>@ajaymyth/*</code> scope. To fetch packages from GitHub, route the <code>@ajaymyth</code> scope in your local <code>.npmrc</code> configuration file:
    </p>
    <CodeBlock code={githubNpmrc} lang="ini" filename=".npmrc" />
    
    <p class="text-xs text-al-muted leading-relaxed mt-4 mb-2">
      After setting up your <code>.npmrc</code> file with your GitHub Personal Access Token (PAT), install the scoped package directly:
    </p>
    <CodeBlock code={githubInstall} lang="bash" filename="Terminal" />

    <!-- Streamlining Note -->
    <div class="my-4 border-l-2 border-al-cyan bg-al-card/15 p-4 rounded-r-lg">
      <p class="text-xs text-al-text leading-relaxed select-all">
        <strong class="text-al-white">Note:</strong> Starting in v2.0.0+, the umbrella <code>afterlink</code> package is optimized for speed and production safety. It has 0 security vulnerabilities and a small dependency footprint. It installs core, server, client, cluster, browser, and CLI tools. The optional terminal AI assistant (<code>@afterlink/ai-assistant</code>) is kept separate. If you want the offline AI assistant, install it explicitly.
      </p>
    </div>

    <!-- Modular distributions -->
    <h2 id="modular-packages" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none font-mono">2. Modular Distribution Packages</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all mb-4">
      If you are building lightweight microservices, embedded nodes, or multi-language services, you can install only the specific packages you need:
    </p>
    
    <div class="overflow-x-auto my-6 border border-al-border rounded-lg bg-al-dark/20 select-all">
      <table class="w-full text-left font-mono text-xs divide-y divide-al-border select-all">
        <thead class="bg-al-black/40 text-al-muted select-none">
          <tr>
            <th class="p-3">Package Name</th>
            <th class="p-3">Purpose</th>
            <th class="p-3">Context / Registry</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-al-border select-all">
          <tr class="hover:bg-al-card/35 transition-colors">
            <td class="p-3 font-semibold text-al-cyan">@afterlink/core / @ajaymyth/core</td>
            <td class="p-3">Binary frame codec (encoder, decoder, Protocol v2 16-byte header)</td>
            <td class="p-3">Any / Universal (npm)</td>
          </tr>
          <tr class="hover:bg-al-card/35 transition-colors">
            <td class="p-3 font-semibold text-al-cyan">@afterlink/server / @ajaymyth/server</td>
            <td class="p-3">High-throughput TCP server runtime module with Prometheus & tracing</td>
            <td class="p-3">Node.js Server (npm)</td>
          </tr>
          <tr class="hover:bg-al-card/35 transition-colors">
            <td class="p-3 font-semibold text-al-cyan">@afterlink/client / @ajaymyth/client</td>
            <td class="p-3">Persistent TCP client wrapper with auto-reconnect & priority framing</td>
            <td class="p-3">Node.js Client (npm)</td>
          </tr>
          <tr class="hover:bg-al-card/35 transition-colors">
            <td class="p-3 font-semibold text-al-cyan">@ajaymyth/cluster</td>
            <td class="p-3">Redis-backed Node clustering, worker crash detection, and SIGUSR2 restarts</td>
            <td class="p-3">Node.js Server (npm)</td>
          </tr>
          <tr class="hover:bg-al-card/35 transition-colors">
            <td class="p-3 font-semibold text-al-cyan">afterlink (PyPI)</td>
            <td class="p-3">Native Python SDK with async client/server, sync wrapper, & Pydantic validation</td>
            <td class="p-3">Python 3.8+ (PyPI)</td>
          </tr>
          <tr class="hover:bg-al-card/35 transition-colors">
            <td class="p-3 font-semibold text-al-cyan">afterlink (pub.dev)</td>
            <td class="p-3">Dart & Flutter SDK with native TCP and web WebSocket transports</td>
            <td class="p-3">Dart 3.0+ / Flutter (pub.dev)</td>
          </tr>
          <tr class="hover:bg-al-card/35 transition-colors">
            <td class="p-3 font-semibold text-al-cyan">@afterlink/browser / @ajaymyth/browser</td>
            <td class="p-3">WebSocket fallback SDK with binary streaming support</td>
            <td class="p-3">Web Browser (npm)</td>
          </tr>
          <tr class="hover:bg-al-card/35 transition-colors">
            <td class="p-3 font-semibold text-al-cyan">@afterlink/cli / @ajaymyth/cli</td>
            <td class="p-3">Command-line debuggers, packet tracers, and validators</td>
            <td class="p-3">Global / CLI (npm)</td>
          </tr>
          <tr class="hover:bg-al-card/35 transition-colors">
            <td class="p-3 font-semibold text-al-cyan">
              <a href="https://www.npmjs.com/package/@afterlink/ai-assistant" target="_blank" rel="noopener noreferrer" class="hover:underline">@afterlink/ai-assistant</a>
            </td>
            <td class="p-3">Offline RAG AI assistant — answers AfterLink questions in your terminal</td>
            <td class="p-3">
              <a href="https://www.npmjs.com/package/@afterlink/ai-assistant" target="_blank" rel="noopener noreferrer" class="hover:underline text-al-cyan">Global / CLI (npm)</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-xs text-al-muted leading-relaxed select-all">
      Install selected modular Node distributions as follows:
    </p>
    <CodeBlock code={modularInstall} lang="bash" filename="Terminal" />

    <!-- Node Clustering -->
    <h2 id="node-clustering-install" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none font-mono">3. Node Clustering Package (@ajaymyth/cluster)</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all mb-4">
      To scale AfterLink horizontally across multi-core Node.js servers with shared Redis pub/sub routing, worker crash detection, and SIGUSR2 rolling restarts, install <code>@ajaymyth/cluster</code>:
    </p>
    <CodeBlock code={clusterInstall} lang="bash" filename="Terminal" />

    <!-- Python SDK Installation -->
    <h2 id="python-sdk-install" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none font-mono">4. Python SDK Installation (afterlink)</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all mb-4">
      The AfterLink Python SDK is published on PyPI under the <code>afterlink</code> package name. Install it using <code>pip</code>:
    </p>
    <CodeBlock code={pythonInstall} lang="bash" filename="Terminal" />

    <!-- Dart SDK Installation -->
    <h2 id="dart-sdk-install" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none font-mono">5. Dart & Flutter SDK Installation (afterlink)</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all mb-4">
      The Dart client SDK is available on pub.dev under <code>afterlink</code>. Add it to your Dart or Flutter project:
    </p>
    <CodeBlock code={dartInstall} lang="bash" filename="Terminal" />

    <!-- Quick Start Server -->
    <h2 id="quickstart-server" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none font-mono">6. Quick Start — Server</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      Create a server script in your project root to handle binary framing:
    </p>
    <CodeBlock code={quickServer} lang="javascript" filename="server.js" />

    <!-- Quick Start Client -->
    <h2 id="quickstart-client" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none font-mono">7. Quick Start — Client</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      Establish a persistent connection from your client and publish your first frame:
    </p>
    <CodeBlock code={quickClient} lang="javascript" filename="client.js" />

    <!-- Command line devtools -->
    <h2 id="cli-devtools" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none font-mono">8. Command-Line Developer Tools</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      AfterLink includes a command-line interface (CLI) to trace active frame streams, inspect live connection channels, and generate mock frame sequences during development:
    </p>
    <CodeBlock code={cliInstall} lang="bash" filename="Terminal" />

    <p class="text-xs text-al-muted leading-relaxed select-all">
      Verify the command line tool installation by checking its version:
    </p>
    <CodeBlock code="afterlink --version" lang="bash" filename="Terminal" />

    <p class="text-xs text-al-muted leading-relaxed select-all mt-4">
      The AfterLink CLI ships with these powerful built-in utility commands:
    </p>
    <ul class="list-disc pl-5 space-y-2 text-xs text-al-muted select-all">
      <li><code>afterlink ping &lt;host:port&gt;</code>: Sends persistent ping packets to calculate heartbeat latencies.</li>
      <li><code>afterlink call &lt;host:port&gt; &lt;route&gt; [payload]</code>: Invokes direct RPC endpoints and reports matching reply values.</li>
      <li><code>afterlink inspect &lt;hex-string&gt;</code>: Decodes raw wire hex buffers into readable, formatted JSON blocks.</li>
      <li><code>afterlink monitor &lt;host:port&gt; &lt;channel&gt;</code>: Listens to real-time pub/sub streams and prints routing traces.</li>
    </ul>

    <!-- Browser CDN -->
    <h2 id="browser-cdn" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none font-mono">9. Browser CDN Fallback Setup</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      If you are building simple frontend HTML interfaces without module bundlers, load the browser client fallback directly via CDN providers:
    </p>
    <CodeBlock code={cdnScript} lang="html" filename="index.html" />

    <!-- Browser Compatibility & Bundler Integration -->
    <h2 id="browser-compatibility" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none font-mono">10. Browser Compatibility & Bundling Fixes</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      To guarantee compatibility across Node.js and client-side web environments, the core package (<code>@afterlink/core</code> / <code>@ajaymyth/core</code>) has been upgraded with a native <code>"browser"</code> mapping configuration inside its <code>package.json</code>.
    </p>
    <div class="my-4 border-l-2 border-al-cyan bg-al-card/15 p-4 rounded-r-lg">
      <p class="text-xs text-al-text leading-relaxed select-all">
        When bundling for the browser (such as in <code>@afterlink/browser</code>), modern bundlers like <strong>esbuild</strong>, <strong>webpack</strong>, or <strong>Vite</strong> will automatically detect this mapping. They will dynamically ignore and stub out Node-specific modules (<code>'net'</code>, <code>'tls'</code>, and <code>'zlib'</code>) and disable Node-specific client files (like <code>TcpClient</code>). This ensures the package builds and functions flawlessly in web applications without requiring complex custom configuration.
      </p>
    </div>

    <!-- TS Setup -->
    <h2 id="typescript-setup" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none font-mono">11. TypeScript Setup & Paths</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      If compiling with TypeScript, declare the paths inside your configuration file for proper module resolution:
    </p>
    <CodeBlock code={tsConfigCode} lang="json" filename="tsconfig.json" />

    <!-- AI Assistant -->
    <h2 id="ai-assistant" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none font-mono">12. AI Assistant (optional)</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      Install the offline AI assistant to ask questions directly in your terminal:
    </p>
    <CodeBlock code={aiAssistantInstall} lang="bash" filename="Terminal" />

    <!-- Upgrading an Existing Project -->
    <h2 id="upgrading-project" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none font-mono">13. Upgrading an Existing Project to v2.0.2</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      If you already have AfterLink installed and want to upgrade all packages to the latest v2.0.2 versions in one go:
    </p>
    <CodeBlock code="npx afterlink upgrade" lang="bash" filename="Terminal" />

    <!-- Prev/Next Navigation -->
    <div class="flex justify-between items-center mt-16 pt-6 border-t border-al-border">
      <a href="/docs" class="group flex items-center gap-2 text-sm font-mono text-al-muted hover:text-al-cyan transition-colors">
        <span class="group-hover:-translate-x-0.5 transition-transform">&larr;</span>
        <span>Getting Started</span>
      </a>
      <a href="/docs/protocol" class="group flex items-center gap-2 text-sm font-mono text-al-muted hover:text-al-cyan transition-colors">
        <span>Protocol Specification</span>
        <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
      </a>
    </div>
  </div>
</DocsLayout>
