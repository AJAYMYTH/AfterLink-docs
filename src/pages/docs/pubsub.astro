---
// src/pages/docs/pubsub.astro
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const pubClient = `
const { Client } = require('@ajaymyth/client');

const client = new Client({ port: 8080 });

client.on('connect', () => {
  console.log('Connected to AfterLink pipeline');

  // 1. Subscribe to exact channel
  client.subscribe('chat.global', (payload) => {
    console.log(\`[Global Chat]: \${payload.text}\`);
  });

  // 2. Publish to channel with priority queue & routing key (Protocol v2)
  client.publish('chat.global', { text: 'Hello developers!' }, { priority: 7, routingKey: 'chat.vip' });
});
`;

const subClientPattern = `
// Subscribe using wildcard routing
client.subscribe('sensors.*', (payload, channel) => {
  console.log(\`Received broadcast on \${channel}: \`, payload);
});
`;

const clusterPubSubPattern = `
const { ClusterManager } = require('@ajaymyth/cluster');

// Configure Redis / Redis Cluster cross-node shared pub/sub
const cluster = new ClusterManager({
  workers: 'auto',
  redis: {
    nodes: ['10.0.0.1:6379', '10.0.0.2:6379', '10.0.0.3:6379'],
    cluster: true // Enabled in v2.0.1+
  }
});

cluster.on('worker', (server) => {
  // Shared channel messages are automatically synchronized across all workers
  server.subscribe('notifications.*', (payload, channel) => {
    console.log(\`[Worker \${process.pid}] \${channel}:\`, payload);
  });
});

cluster.start();
`;
---

<DocsLayout 
  title="Pub/Sub System — Channel Messaging & Broadcasting" 
  description="Learn AfterLink's built-in publish/subscribe system with native channel messaging, wildcard subscriptions, and zero-dependency broadcasting."
  schema={{
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": "Pub/Sub System — Channel Messaging & Broadcasting",
    "description": "Learn AfterLink's built-in publish/subscribe system with native channel messaging, wildcard subscriptions, and zero-dependency broadcasting.",
    "author": { "@type": "Person", "name": "Javali Ajayakumar" },
    "publisher": { "@type": "Organization", "name": "AfterLink" },
    "mainEntityOfPage": "https://afterlink-docs.vercel.app/docs/pubsub"
  }}
>
  <div class="space-y-6">
    <div class="border-b border-al-border/50 pb-4">
      <h1 class="text-3xl font-bold tracking-tight text-al-white mb-2">Pub/Sub Messaging System</h1>
      <p class="text-sm text-al-muted leading-relaxed">
        AfterLink features a high-performance publish/subscribe messaging engine baked directly into the socket protocol layer. Deliver real-time broad-scope channels with minimal wire steps.
      </p>
    </div>

    <!-- Architectural Overview -->
    <h2 id="overview" class="text-lg font-semibold tracking-tight text-al-white mt-8 mb-3 select-none">How it Works</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      Unlike HTTP polling or traditional WebSockets where pub/sub routing must be written on top of JSON buffers in the application space, AfterLink utilizes dedicated message type bytes (<code>MSG_SUBSCRIBE</code> - <code>0x02</code> and <code>MSG_PUBLISH</code> - <code>0x03</code>) to instruct the server on channel routing:
    </p>

    <!-- Visual schema -->
    <div class="p-6 rounded-lg border border-al-border bg-al-card/25 font-mono text-3xs text-al-muted select-all my-6">
      <div class="flex flex-col gap-1">
        <div class="flex justify-between items-center bg-al-black/40 p-2.5 rounded border border-al-border select-all">
          <span class="text-al-white">1. Client registers channel</span>
          <span class="text-al-cyan">0x02 (MSG_SUBSCRIBE) + "chat.global"</span>
        </div>
        <div class="text-center font-bold text-al-cyan select-none">&darr;</div>
        <div class="flex justify-between items-center bg-al-black/40 p-2.5 rounded border border-al-border select-all">
          <span class="text-al-white">2. Server stores registry map</span>
          <span class="text-al-muted">Sets Socket connection in channel memory array</span>
        </div>
        <div class="text-center font-bold text-al-cyan select-none">&darr;</div>
        <div class="flex justify-between items-center bg-al-cyan/5 p-2.5 rounded border border-al-cyan/20 select-all">
          <span class="text-al-cyan">3. Message published</span>
          <span class="text-al-text">0x03 (MSG_PUBLISH) to "chat.global" -> server loops & relays header frames</span>
        </div>
      </div>
    </div>

    <!-- Client Pub/Sub Code Example -->
    <h2 id="pubsub-code" class="text-lg font-semibold tracking-tight text-al-white mt-10 mb-3 select-none">Client Pub/Sub Code Example</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      Below is an implementation showing how simple it is to register subscribers and push events onto channels:
    </p>
    <CodeBlock code={pubClient} lang="javascript" filename="pubsub-client.js" />

    <!-- Channel routing patterns -->
    <h2 id="patterns" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none">Channel Routing Patterns</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      AfterLink supports two levels of channel routing matching structures:
    </p>
    <ul class="list-disc pl-5 space-y-3 text-xs text-al-muted select-all">
      <li>
        <strong>Exact Matching:</strong> Routes messages only to subscribers bound to the exact string channel, such as <code>chat.room1</code>.
      </li>
      <li>
        <strong>Wildcard Routing (Single level):</strong> Using the asterisks character (<code>*</code>), clients can subscribe to entire subgroups. For instance, subscribing to <code>sensors.*</code> catches broadcasts pushed to <code>sensors.temperature</code>, <code>sensors.pressure</code>, etc:
      </li>
    </ul>
    
    <CodeBlock code={subClientPattern} lang="javascript" filename="wildcard-sub.js" />

    <!-- Cross-Node Redis & Redis Cluster Shared Pub/Sub -->
    <h2 id="cluster-pubsub" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none">Cross-Node Redis & Redis Cluster Shared Pub/Sub</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      Using <code>@ajaymyth/cluster</code>, AfterLink pub/sub channels automatically bridge across worker process boundaries and multi-server instances using Redis or Redis Cluster (<code>Redis.Cluster</code> support added in v2.0.1). Messages published on any node are routed transparently across all subscribed socket workers.
    </p>

    <CodeBlock code={clusterPubSubPattern} lang="javascript" filename="cluster-pubsub.js" />

    <!-- Priority Queues and Routing Keys -->
    <h2 id="priority-routing-keys" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none">Priority Queues & Custom Routing Keys</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      Protocol v2 embeds <strong>priority level queues (0-7)</strong> and <strong>custom string routing keys (0-255 bytes)</strong> directly inside the 16-byte fixed binary header:
    </p>
    <ul class="list-disc pl-5 space-y-2 text-xs text-al-muted select-all mb-4">
      <li>
        <strong>Priority Queues (0-7):</strong> Priority level <code>7</code> represents urgent system traffic (e.g. <code>PRIORITY_ACK</code>, emergency alerts), while level <code>0</code> is default background traffic. Server output buffers process higher priority frame queues first under high load.
      </li>
      <li>
        <strong>Custom String Routing Keys (0-255 bytes):</strong> Enables fine-grained routing filters and topic key metadata without needing to modify the main channel name or deserialize the MessagePack payload body.
      </li>
    </ul>

    <!-- Prev/Next Navigation -->
    <div class="flex justify-between items-center mt-16 pt-6 border-t border-al-border">
      <a href="/docs/api" class="group flex items-center gap-2 text-sm font-mono text-al-muted hover:text-al-cyan transition-colors">
        <span class="group-hover:-translate-x-0.5 transition-transform">&larr;</span>
        <span>API Reference</span>
      </a>
      <a href="/docs/validation" class="group flex items-center gap-2 text-sm font-mono text-al-muted hover:text-al-cyan transition-colors">
        <span>Schema Validation</span>
        <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
      </a>
    </div>
  </div>
</DocsLayout>
