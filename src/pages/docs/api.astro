    <CodeBlock code={`export interface Frame {
  magic: number[];        // Fixed magic identifier: [0xAF, 0x1C]
  version: number;        // Protocol version: 0x02 (v2) or 0x01 (v1)
  type: number;           // Message type byte (0x01-0x0A, 0xFE, 0xFF)
  flags: number;          // Bitwise flags (bit 0: compressed)
  priority: number;       // Priority level queue (0-7)
  seq: number;            // Sequence ID (0 - 65535)
  routingKeyLength: number; // Length of routing key (0 - 255 bytes)
  routingKey?: string;    // Custom string routing key (0 - 255 bytes)
  length: number;         // Payload size in bytes (uint32)
  payload: any;           // Parsed payload JS Object
  rawPayload: Buffer;     // Raw buffer reference
}

export interface ServerOptions {
  port?: number;
  host?: string;
  idleTimeout?: number;
  maxConnections?: number;
  tls?: {
    key: Buffer;
    cert: Buffer;
  };
  metrics?: {
    enabled?: boolean;
    port?: number;
    path?: string;
  };
  tracing?: any;
}

export interface ClientOptions {
  host?: string;
  port?: number;
  autoReconnect?: boolean;
  maxRetries?: number;
  priority?: number;
  routingKey?: string;
}

export interface ClusterOptions {
  workers?: number | 'auto';
  redis?: string | { nodes: string[] };
  autoRestart?: boolean;
  rollingRestart?: boolean;
}`} lang="typescript" filename="index.d.ts" />

