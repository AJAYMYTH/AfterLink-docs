const chatAppExample = `
// ==================== server.js ====================
const { Server } = require('@afterlink/server');
const server = new Server({ port: 8080 });

console.log('AfterLink Chat Daemon active on 8080');

// ==================== client.js ====================
const { Client } = require('@afterlink/client');
const client = new Client({ port: 8080 });

client.on('connect', () => {
  // Subscribe to central messaging channel
  client.subscribe('chat.lobby', (message) => {
    console.log(\`[\${message.user}]: \${message.text}\`);
  });

  // Push user chat message frame
  client.publish('chat.lobby', { user: 'Alice', text: 'Hi lobby!' });
});
`;

const metricsDashboardExample = `
const { Server } = require('@afterlink/server');
const server = new Server({ port: 8080 });

// Periodically stream CPU, Memory metrics to dashboard clients
setInterval(() => {
  const metrics = {
    cpu: Math.random() * 100,
    memory: process.memoryUsage().heapUsed,
    timestamp: Date.now()
  };
  
  server.broadcast('DATA', {
    channel: 'metrics.live',
    data: metrics
  });
}, 1000);
`;

const rpcExample = `
const { Client } = require('@afterlink/client');
const client = new Client({ port: 8080 });

// Utility to handle RPC Request/Response over binary framing
function request(method, params) {
  return new Promise((resolve, reject) => {
    const seq = Math.floor(Math.random() * 65535);
    
    // Register temporary ACK / reply event listener
    const handler = (frame) => {
      if (frame.type === 'ACK' && frame.payload.replyTo === seq) {
        client.off('message', handler);
        resolve(frame.payload.result);
      }
    };
    client.on('message', handler);
    
    // Send standard action method frame
    client.send('DATA', { method, params }, { seq });
  });
}
`;

const reconnectExample = `
const { Client } = require('@afterlink/client');

const client = new Client({
  port: 8080,
  autoReconnect: true,
  maxRetries: 10
});

client.on('disconnect', () => {
  console.warn('Pipeline broken. Retrying handshake connection...');
});

client.on('reconnect', (attempt) => {
  console.log(\`Successfully reconnected on attempt #\${attempt}!\`);
});
`;

const nodeClusterExample = `
// ==================== cluster-master.js ====================
const { ClusterManager } = require('@ajaymyth/cluster');

// Spawn multi-worker cluster with Redis-backed shared pub/sub routing
const cluster = new ClusterManager({
  workers: 'auto', // Auto-scales across CPU cores
  port: 8080,
  redis: {
    // Single node or Redis Cluster slot routing (v2.0.1+)
    clusters: [{ host: '127.0.0.1', port: 6379 }],
    keyPrefix: 'afterlink:cluster:'
  },
  restartOnCrash: true
});

// Zero-downtime rolling worker reload on SIGUSR2
process.on('SIGUSR2', async () => {
  console.log('Rolling restart initiated across cluster worker pool...');
  await cluster.reloadWorkers();
});

cluster.start().then(() => {
  console.log(\`Cluster master PID \${process.pid} routing active on port 8080\`);
});
`;

const pythonSdkExample = `
# ==================== python_server.py ====================
import asyncio
from pydantic import BaseModel
from afterlink import AsyncServer, Frame, Priority

class UserActionPayload(BaseModel):
    user_id: str
    action: str
    metadata: dict = {}

app = AsyncServer(host="127.0.0.1", port=8080)

@app.route("user.action")
async def handle_action(frame: Frame[UserActionPayload]) -> dict:
    payload = frame.payload  # Type-hinted Pydantic model
    print(f"[{payload.user_id}] Action: {payload.action} (Priority: {frame.priority})")
    return {"status": "success", "processed_by": "python_sdk"}

# ==================== python_client.py ====================
from afterlink import AsyncClient, Priority

async def main():
    # Async context manager handles handshake and pipeline lifecycle
    async with AsyncClient("127.0.0.1", 8080) as client:
        # Transmit Protocol v2 frame with priority queue 5 & custom routing key
        response = await client.request(
            route="user.action",
            payload={"user_id": "usr_772", "action": "login"},
            priority=Priority.HIGH  # Priority level (0-7)
        )
        print("Server response:", response)

if __name__ == "__main__":
    asyncio.run(main())
`;

const dartSdkExample = `
// ==================== main.dart ====================
import 'package:afterlink/afterlink.dart';

void main() async {
  // Conditional compilation loader automatically selects
  // native TCP (io) or WebSocket bridge (web) depending on target platform
  final client = AfterLinkClient(
    host: '127.0.0.1',
    port: 8080,
    autoReconnect: true,
  );

  client.onConnect(() {
    print('AfterLink Dart client active via native/web transport');

    // Subscribe to cluster-wide pub/sub channel using msgpack_dart codec
    client.subscribe('telemetry.stream', (frame) {
      print('Stream event: \${frame.payload}');
    });

    // Transmit high-priority Protocol v2 frame
    client.publish(
      'telemetry.stream',
      {'device': 'flutter_mobile', 'battery': 95},
      priority: 6,
    );
  });

  await client.connect();
}
`;

const observabilityExample = `
// ==================== server-metrics.js ====================
const { Server } = require('@ajaymyth/server');
const { PrometheusMetrics, TracingManager } = require('@ajaymyth/core');

// OpenTelemetry-compliant TracingManager with AsyncLocalStorage context propagation
const tracer = new TracingManager({
  serviceName: 'afterlink-edge-service',
  exporterUrl: 'http://localhost:4318/v1/traces'
});

// Self-contained Prometheus metric exporter
const metrics = new PrometheusMetrics({
  prefix: 'afterlink_',
  collectDefaultMetrics: true
});

const server = new Server({
  port: 8080,
  tracing: tracer,
  metrics: metrics
});

// Expose Prometheus metric scrape endpoint
server.get('/metrics', async (req, res) => {
  res.setHeader('Content-Type', metrics.contentType);
  res.send(await metrics.metrics());
});

// Route handler with traced span context
server.on('payment.process', async (socket, frame) => {
  const span = tracer.startSpan('processPayment', { frameId: frame.id });
  try {
    metrics.incrementCounter('payments_processed_total', { status: 'success' });
    return { status: 'completed', txnId: 'txn_9012' };
  } finally {
    span.end();
  }
});
`;
