---
// src/pages/docs/skills.astro
import DocsLayout from '../../layouts/DocsLayout.astro';
---

<DocsLayout 
  title="Skills System — Modular Plugin Architecture" 
  description="Extend AfterLink with the modular Skills system. Create, register, and manage pluggable functionality with lifecycle hooks and AI agent integration."
  schema={{
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": "Skills System — Modular Plugin Architecture",
    "description": "Extend AfterLink with the modular Skills system. Create, register, and manage pluggable functionality with lifecycle hooks and AI agent integration.",
    "author": { "@type": "Person", "name": "Javali Ajayakumar" },
    "publisher": { "@type": "Organization", "name": "AfterLink" },
    "mainEntityOfPage": "https://afterlink-docs.vercel.app/docs/skills"
  }}
>
  <div class="space-y-6">
    <div class="border-b border-al-border/50 pb-4">
      <h1 class="text-3xl font-bold tracking-tight text-al-white mb-2">AI Agent Skills</h1>
      <p class="text-sm text-al-muted leading-relaxed">
        AfterLink ships a fully structured <code class="text-al-cyan">skills.sh</code>-compatible skill configuration package updated for <code class="text-al-cyan">v2.0.2</code>. This teaches AI coding assistants (Claude, Cursor, Copilot) how to scaffold Protocol v2 framing, multi-worker clustering, and multi-language SDKs natively without API hallucinations.
      </p>
    </div>

    <!-- What is a skill -->
    <div class="bg-al-card border border-al-border rounded-xl p-6 my-6 select-all shadow-sm">
      <h2 class="font-mono text-xs font-bold text-al-cyan uppercase tracking-wider mb-2">What is a Skill?</h2>
      <p class="text-xs text-al-text leading-relaxed">
        A skill is a machine-readable technical instruction playbook. By injecting AfterLink's Protocol v2 16-byte header specification, <code class="text-al-cyan">@ajaymyth/cluster</code> engine rules, Python/Dart SDK contracts, and Zod validation models directly into the AI's system prompt context, coding tools can create, audit, and debug AfterLink protocol layers with zero-defect accuracy.
      </p>
    </div>

    <!-- Installation -->
    <h2 id="installation" class="text-lg font-semibold tracking-tight text-al-white mt-10 mb-3 select-none font-mono">Installation</h2>
    
    <div class="space-y-4">
      <div>
        <p class="text-[10px] text-al-muted font-mono uppercase tracking-widest mb-2 font-semibold">
          Installation Command
        </p>
        <div class="flex items-center gap-3 bg-al-card border border-al-border rounded-lg px-4 py-3 font-mono text-sm shadow-sm select-all">
          <span class="text-al-muted select-none">$</span>
          <span class="text-al-text flex-1 text-xs sm:text-sm" id="skill-pkg-cmd">npx skills add AJAYMYTH/afterlink-skill</span>
          <button 
            onclick="copyCodeText('npx skills add AJAYMYTH/afterlink-skill', this)"
            class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border border-al-border hover:border-al-cyan/40 bg-al-bg hover:bg-al-card text-xs text-al-muted hover:text-al-cyan transition-all shrink-0 cursor-pointer select-none shadow-xs"
            aria-label="Copy skills install command"
          >
            <svg class="copy-svg h-3 w-3 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
            </svg>
            <svg class="check-svg h-3 w-3 hidden text-al-green shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span class="btn-text">copy</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Skill Coverage list -->
    <h2 id="coverage" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none font-mono">What the Skill Book Covers</h2>
    <p class="text-xs text-al-muted leading-relaxed select-all">
      The skill blueprint instructs AI agents across the complete range of AfterLink v2.0.2 capabilities:
    </p>

    <div class="overflow-x-auto my-6 border border-al-border rounded-lg bg-al-dark/20 select-all">
      <table class="w-full text-left font-mono text-xs divide-y divide-al-border select-all">
        <thead class="bg-al-black/40 text-al-muted select-none">
          <tr>
            <th class="p-3">Skill Chapter</th>
            <th class="p-3">Protocol Domain & Coverage details</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-al-border select-all">
          <tr><td class="p-3 font-semibold text-al-cyan">Protocol v2 Framing</td><td class="p-3">16-byte fixed header layout, version negotiation (v1/v2), priority queues (0-7), 0-255 byte custom routing keys, <code>ROUTE_REQUEST</code> & <code>PRIORITY_ACK</code> frame types.</td></tr>
          <tr><td class="p-3 font-semibold text-al-cyan">Node Clustering (@ajaymyth/cluster)</td><td class="p-3">Redis-backed shared pub/sub routing, Redis Cluster slot support (v2.0.1+), worker crash detection, and SIGUSR2 rolling restarts.</td></tr>
          <tr><td class="p-3 font-semibold text-al-cyan">Python SDK (afterlink)</td><td class="p-3">Async server and client implementation, sync wrapper, type hints, and Pydantic schema validation.</td></tr>
          <tr><td class="p-3 font-semibold text-al-cyan">Dart & Flutter SDK (afterlink)</td><td class="p-3">Native TCP & web WebSocket transports via conditional compilation loaders, <code>msgpack_dart</code> serialization.</td></tr>
          <tr><td class="p-3 font-semibold text-al-cyan">Metrics & Observability</td><td class="p-3">Prometheus scrape endpoint configuration, Grafana JSON templates, and OpenTelemetry <code>TracingManager</code> with AsyncLocalStorage context propagation.</td></tr>
          <tr><td class="p-3 font-semibold text-al-cyan">Decision Guide</td><td class="p-3">When to deploy AfterLink binary TCP vs standard WebSockets, HTTP/2 or gRPC configurations.</td></tr>
          <tr><td class="p-3 font-semibold text-al-cyan">Server Scaffolds</td><td class="p-3">How to boot server nodes, assign routes, and declare Zod payload validation models.</td></tr>
          <tr><td class="p-3 font-semibold text-al-cyan">Client Handshakes</td><td class="p-3">Establishing client pipes, auto-reconnecting loops, and request/reply RPC actions.</td></tr>
          <tr><td class="p-3 font-semibold text-al-cyan">Pub/Sub Broadcasting</td><td class="p-3">Channel subscriptions, raw publishes, and multi-peer broadcast loops.</td></tr>
          <tr><td class="p-3 font-semibold text-al-cyan">Secure TLS & JWT</td><td class="p-3">Creating credentials via <code>generateDevCerts()</code> and securing URIs with JWT secrets.</td></tr>
          <tr><td class="p-3 font-semibold text-al-cyan">Browser Bridge</td><td class="p-3">Interfacing with standard web frontend elements using WebSocket fallback wrappers.</td></tr>
          <tr><td class="p-3 font-semibold text-al-cyan">Diagnostics & CLI</td><td class="p-3">API testing structures, CLI debuggers (<code>afterlink ping/inspect</code>), and common issue resolutions.</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Usage guidelines -->
    <h2 id="usage" class="text-lg font-semibold tracking-tight text-al-white mt-12 mb-3 select-none font-mono">Using with Claude / Cursor / Copilot</h2>
    <div class="bg-al-card border border-al-border rounded-xl p-6 shadow-sm select-all">
      <p class="text-xs text-al-muted leading-relaxed mb-4 select-all">
        Once the skill package is installed inside your local repository configurations, you can prompt your editor agent with high-level goals:
      </p>
      <div class="flex items-start sm:items-center gap-3 bg-al-bg border border-al-border rounded-lg px-4 py-3.5 font-mono shadow-inner select-all">
        <span class="text-al-cyan italic text-xs flex-1 select-all" id="prompt-text">
          "According to the local AfterLink skill, scaffold a multi-worker cluster using @ajaymyth/cluster with Redis-backed pub/sub routing, register a Protocol v2 route with priority level 5, and write a Python AsyncClient script using the afterlink package that sends a Pydantic-validated payload."
        </span>
        <button 
          onclick="copyCodeText(document.getElementById('prompt-text').textContent.trim(), this)"
          class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border border-al-border hover:border-al-cyan/40 bg-al-card hover:bg-al-bg text-xs text-al-muted hover:text-al-cyan transition-all shrink-0 cursor-pointer select-none shadow-xs mt-1 sm:mt-0"
          aria-label="Copy prompt text"
        >
          <svg class="copy-svg h-3 w-3 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <svg class="check-svg h-3 w-3 hidden text-al-green shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span class="btn-text">copy</span>
        </button>
      </div>
      <p class="text-[10px] text-al-muted mt-3 font-mono tracking-tight select-none">
        The agent will automatically locate the skill guidelines, fetch correct API signatures, and write validated Node, Python, or Dart code.
      </p>
    </div>

    <!-- Prev/Next Navigation -->
    <div class="flex justify-between items-center mt-16 pt-6 border-t border-al-border">
      <a href="/docs/validation" class="group flex items-center gap-2 text-sm font-mono text-al-muted hover:text-al-cyan transition-colors">
        <span class="group-hover:-translate-x-0.5 transition-transform">&larr;</span>
        <span>Schema Validation</span>
      </a>
      <a href="/docs/examples" class="group flex items-center gap-2 text-sm font-mono text-al-muted hover:text-al-cyan transition-colors">
        <span>Code Examples</span>
        <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
      </a>
    </div>
  </div>
</DocsLayout>

<script is:inline>
  function copyCodeText(text, btn) {
    const copySvg = btn.querySelector('.copy-svg');
    const checkSvg = btn.querySelector('.check-svg');
    const btnText = btn.querySelector('.btn-text');
    
    navigator.clipboard.writeText(text).then(() => {
      if (copySvg && checkSvg && btnText) {
        copySvg.classList.add('hidden');
        checkSvg.classList.remove('hidden');
        btnText.textContent = 'copied';
        
        btn.classList.add('text-al-green', 'border-al-green/40', 'bg-al-green/5');
        btn.classList.remove('text-al-muted');
        
        setTimeout(() => {
          copySvg.classList.remove('hidden');
          checkSvg.classList.add('hidden');
          btnText.textContent = 'copy';
          
          btn.classList.remove('text-al-green', 'border-al-green/40', 'bg-al-green/5');
          btn.classList.add('text-al-muted');
        }, 2000);
      }
    });
  }
</script>
