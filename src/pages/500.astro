---
// src/pages/500.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="500 Internal Server Error — AfterLink">
  <Navbar />
  
  <div class="max-w-xl mx-auto px-4 sm:px-6 py-24 flex-1 flex flex-col justify-center text-center select-none relative">
    <!-- Center background red glow for server error -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[180px] bg-red-500/5 blur-[90px] rounded-full select-none pointer-events-none"></div>

    <!-- Glowing numeric block -->
    <div class="relative z-10">
      <h1 class="text-8xl sm:text-9xl font-mono font-bold text-red-500 tracking-tighter drop-shadow-[0_0_30px_rgba(239,68,68,0.25)] select-none">
        500
      </h1>
      <h2 class="text-xl font-mono font-semibold text-al-white mt-6 mb-3">
        Internal Server Error
      </h2>
      <p class="text-al-muted text-xs sm:text-sm leading-relaxed max-w-sm mx-auto mb-10">
        An unexpected error occurred on our servers. The team has been notified. Please refresh the page, try again later, or contact us directly.
      </p>

      <!-- Action buttons -->
      <div class="flex flex-col sm:flex-row justify-center gap-4 max-w-xs sm:max-w-none mx-auto select-none">
        <a 
          href="/" 
          class="w-full sm:w-auto inline-flex items-center justify-center rounded border border-al-border bg-al-card px-6 py-2.5 font-mono text-sm text-al-white hover:border-al-cyan/30 hover:bg-al-bg transition-all focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-al-cyan cursor-pointer"
        >
          &larr; Go Home
        </a>
        <a 
          href="/contact" 
          class="w-full sm:w-auto inline-flex items-center justify-center rounded bg-red-500/10 border border-red-500/25 hover:bg-red-500/20 px-6 py-2.5 font-mono text-sm text-red-400 font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500/50 cursor-pointer"
        >
          Contact Support
        </a>
      </div>
    </div>
  </div>

  <Footer />
</BaseLayout>
