---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FeatureCard from '../components/FeatureCard.astro';
import FrameVisualizer from '../components/FrameVisualizer.astro';
import HellBackground from '../components/backgrounds/HellBackground';
import { ScrollReveal } from '../components/lightswind/scroll-reveal';
---

<BaseLayout 
  title="AfterLink — High-Performance Binary Protocol for Real-Time Communication" 
  description="AfterLink is a high-performance binary protocol with persistent TCP connections, native pub/sub, and automatic schema validation. 76% faster than WebSocket with a 10-byte binary header."
  schema={{
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "AfterLink",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Cross-platform",
    "description": "A high-performance binary protocol with persistent TCP connections, native pub/sub, and automatic schema validation for real-time applications.",
    "url": "https://afterlink-docs.vercel.app",
    "author": { "@type": "Person", "name": "Javali Ajayakumar" },
    "programmingLanguage": "JavaScript",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "license": "https://github.com/AJAYMYTH/AfterLink/blob/main/LICENSE"
  }}
>
  <!-- Hero + Navbar share one WebGL canvas layer -->
  <div class="relative w-full" id="hero-wrapper">
    <!-- HellBackground behind BOTH navbar and hero content -->
    <div class="absolute inset-0 select-none pointer-events-none" aria-hidden="true">
      <HellBackground
        client:only="react"
        color="#00d8ff"
        backdropBlurAmount="none"
        className="absolute inset-0 w-full h-full opacity-35 dark:opacity-45"
      />
    </div>
    <!-- Soft vignette / readability gradient on the canvas -->
    <div class="absolute inset-0 bg-gradient-to-b from-al-bg/50 via-transparent to-al-bg/90 select-none pointer-events-none"></div>
    <!-- Grid texture on top -->
    <div class="absolute inset-0 hero-bg opacity-15 select-none pointer-events-none"></div>

  <Navbar />
  <main id="main-content">

  <!-- Hero + Navbar wrapper closes after hero section -->
  <!-- Hero Section -->
  <section class="relative w-full overflow-hidden border-b border-al-border py-20 md:py-28 transition-colors">

    <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center select-none">
      
      <!-- Premium Version Tag -->
      <div class="mb-4 inline-flex items-center gap-1.5 rounded-full border border-al-cyan/30 bg-al-cyan/5 px-3 py-1 font-mono text-[10px] text-al-cyan tracking-wider uppercase animate-hero-tag">
        <span class="h-1.5 w-1.5 rounded-full bg-al-cyan animate-pulse"></span>
        v1.2.1 Active
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-al-white text-pretty max-w-3xl leading-[1.1] mb-6 animate-hero-title">
        A Binary Protocol <br class="hidden sm:inline" />
        Built for <span class="bg-gradient-to-r from-al-cyan via-al-blue to-al-green bg-clip-text text-transparent">Extreme Speed</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-sm sm:text-base text-al-muted max-w-2xl leading-relaxed text-balance mb-10 animate-hero-desc">
        AfterLink provides persistent socket connections, native pub/sub routing, and automatic schema validation—all compressed into a 10-byte binary header. Built with zero dependencies.
      </p>

      <!-- CTA Action Buttons -->
      <div class="flex flex-wrap justify-center gap-4 mb-12 w-full max-w-xs sm:max-w-none animate-hero-ctas">
        <a 
          href="/docs" 
          class="btn-primary w-full sm:w-auto inline-flex items-center justify-center rounded px-6 py-2.5 font-mono text-sm font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-al-cyan/50"
        >
          Get Started &rarr;
        </a>
        <a 
          href="/playground" 
          class="w-full sm:w-auto inline-flex items-center justify-center rounded border border-al-border bg-al-card px-6 py-2.5 font-mono text-sm text-al-white hover:border-al-cyan/30 hover:bg-al-bg transition-all focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-al-cyan"
        >
          Live Playground
        </a>
      </div>

      <!-- Hero Install Commands & Badges -->
      <div class="w-full max-w-lg space-y-5 text-left mb-16 select-text animate-hero-install">
        
        <!-- npm install command -->
        <div class="install-block w-full">
          <p class="text-[9px] text-al-muted font-mono uppercase tracking-widest mb-1.5 font-bold select-none">
            npm package
          </p>
          <div class="flex items-center gap-3 bg-al-bg/40 dark:bg-black/30 border border-al-cyan/20 dark:border-al-cyan/25 rounded-lg px-4 py-3 font-mono shadow-sm select-all backdrop-blur-md" style="box-shadow: 0 0 18px -4px rgba(0,216,255,0.12), inset 0 1px 0 rgba(255,255,255,0.06);">
            <span class="text-al-muted select-none text-xs sm:text-sm">$</span>
            <span class="text-al-text flex-1 text-xs sm:text-sm overflow-x-auto whitespace-nowrap" id="npm-cmd">npm install afterlink</span>
            <button 
              id="npm-btn-hero"
              class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border border-al-border hover:border-al-cyan/40 bg-al-bg hover:bg-al-card text-xs text-al-muted hover:text-al-cyan transition-all shrink-0 cursor-pointer select-none shadow-xs"
              aria-label="Copy npm install command"
            >
              <svg class="copy-svg h-3 w-3 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
              </svg>
              <svg class="check-svg h-3 w-3 hidden text-al-green shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span class="btn-text">copy</span>
            </button>
          </div>
          <!-- npm badge link -->
          <a 
            href="https://www.npmjs.com/package/afterlink"
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 mt-2 text-[10px] text-al-muted hover:text-al-cyan transition-colors font-mono select-none"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M0 0h24v24H0V0zm7.07 4.5H3v15h9v-3H7.07V4.5zm2.93 0v12h3V7.5h3v9h3V4.5H10z"/>
            </svg>
            npmjs.com/package/afterlink ↗
          </a>
        </div>

        <!-- Individual packages -->
        <div class="install-block w-full">
          <p class="text-[9px] text-al-muted font-mono uppercase tracking-widest mb-1.5 font-bold select-none">
            or install modules individually
          </p>
          <div class="bg-al-bg/40 dark:bg-black/30 border border-al-cyan/20 dark:border-al-cyan/25 rounded-lg px-4 py-3 font-mono text-xs text-al-muted space-y-1 select-all backdrop-blur-md" style="box-shadow: 0 0 18px -4px rgba(0,216,255,0.12), inset 0 1px 0 rgba(255,255,255,0.06);">
            <div>npm install <span class="text-al-cyan">@afterlink/server</span></div>
            <div>npm install <span class="text-al-cyan">@afterlink/client</span></div>
            <div>npm install <span class="text-al-cyan">@afterlink/browser</span></div>
            <div>npm install <span class="text-al-cyan">@afterlink/cli</span></div>
          </div>
        </div>

        <!-- skills.sh install command -->
        <div class="install-block w-full">
          <p class="text-[9px] text-al-muted font-mono uppercase tracking-widest mb-1.5 font-bold select-none">
            AI agent skill (skills.sh)
          </p>
          <div class="flex items-center gap-3 bg-al-bg/40 dark:bg-black/30 border border-al-cyan/20 dark:border-al-cyan/25 rounded-lg px-4 py-3 font-mono shadow-sm select-all backdrop-blur-md" style="box-shadow: 0 0 18px -4px rgba(0,216,255,0.12), inset 0 1px 0 rgba(255,255,255,0.06);">
            <span class="text-al-muted select-none text-xs sm:text-sm">$</span>
            <span class="text-al-text flex-1 text-xs sm:text-sm overflow-x-auto whitespace-nowrap" id="skill-cmd">npx skills add AJAYMYTH/afterlink-skill</span>
            <button 
              id="skill-btn-hero"
              class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-md border border-al-border hover:border-al-cyan/40 bg-al-bg hover:bg-al-card text-xs text-al-muted hover:text-al-cyan transition-all shrink-0 cursor-pointer select-none shadow-xs"
              aria-label="Copy agent skill command"
            >
              <svg class="copy-svg h-3 w-3 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
              </svg>
              <svg class="check-svg h-3 w-3 hidden text-al-green shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span class="btn-text">copy</span>
            </button>
          </div>
        </div>

      </div>

      <!-- Interactive visualizer centerpiece -->
      <div class="w-full animate-hero-viz">
        <FrameVisualizer />
      </div>

    </div>
  </section>
  </div><!-- /hero-wrapper -->

  <!-- ===== FEATURES (6 Cards) ===== -->
  <section id="features" class="py-24 px-4 sm:px-6 max-w-6xl mx-auto transition-colors">
    <div class="text-center mb-16 select-none">
      <p class="text-al-cyan font-mono text-xs font-bold uppercase tracking-widest mb-2">Features Matrix</p>
      <h2 class="text-2xl sm:text-3xl font-bold text-al-white font-mono">
        Built for real-time. Ready for production.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

      <!-- Card 1 -->
      <div class="feature-card p-6 rounded-xl bg-al-card select-text">
        <div class="mb-4 select-none">
          <svg class="w-6 h-6 text-al-cyan" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="text-al-white font-mono font-semibold text-base mb-2">
          Persistent Connections
        </h3>
        <p class="text-al-muted text-xs leading-relaxed select-all">
          TCP connections stay open — no handshake overhead per request.
          AfterLink maintains a single long-lived socket with automatic
          keepalive pings every 30 seconds.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="feature-card p-6 rounded-xl bg-al-card select-text">
        <div class="mb-4 select-none">
          <svg class="w-6 h-6 text-al-cyan" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 19a1.5 1.5 0 100-3 1.5 1.5 0 000 3z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12a5 5 0 018 0M5 9a9 9 0 0114 0" />
          </svg>
        </div>
        <h3 class="text-al-white font-mono font-semibold text-base mb-2">
          Built-in Pub/Sub
        </h3>
        <p class="text-al-muted text-xs leading-relaxed select-all">
          Native channel-based publish/subscribe baked into the protocol layer.
          No Redis, no extra broker. Subscribe, publish, and broadcast with
          one line of code.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="feature-card p-6 rounded-xl bg-al-card select-text">
        <div class="mb-4 select-none">
          <svg class="w-6 h-6 text-al-cyan" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h3 class="text-al-white font-mono font-semibold text-base mb-2">
          Auto Validation
        </h3>
        <p class="text-al-muted text-xs leading-relaxed select-all">
          Zod schema validation built into every route handler.
          Invalid payloads are rejected at the protocol level before
          your business logic runs — zero boilerplate.
        </p>
      </div>

      <!-- Card 4 -->
      <div class="feature-card p-6 rounded-xl bg-al-card select-text">
        <div class="mb-4 select-none">
          <svg class="w-6 h-6 text-al-cyan" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
        <h3 class="text-al-white font-mono font-semibold text-base mb-2">
          10-Byte Binary Frame
        </h3>
        <p class="text-al-muted text-xs leading-relaxed select-all">
          Every message starts with a fixed 10-byte header containing magic bytes,
          version, message type, sequence number, and payload length.
          MessagePack serialization for the payload — compact and fast.
        </p>
      </div>

      <!-- Card 5 -->
      <div class="feature-card p-6 rounded-xl bg-al-card select-text">
        <div class="mb-4 select-none">
          <svg class="w-6 h-6 text-al-cyan" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h3 class="text-al-white font-mono font-semibold text-base mb-2">
          TLS + JWT Auth
        </h3>
        <p class="text-al-muted text-xs leading-relaxed select-all">
          First-class TLS support with <code class="text-al-cyan">afterlinks://</code> URIs.
          JWT middleware included out of the box. Dev certs generated
          automatically with <code class="text-al-cyan">generateDevCerts()</code>.
        </p>
      </div>

      <!-- Card 6 -->
      <div class="feature-card p-6 rounded-xl bg-al-card select-text">
        <div class="mb-4 select-none">
          <svg class="w-6 h-6 text-al-cyan" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
        </div>
        <h3 class="text-al-white font-mono font-semibold text-base mb-2">
          Browser Bridge
        </h3>
        <p class="text-al-muted text-xs leading-relaxed select-all">
          Use AfterLink from any browser via the built-in WebSocket bridge.
          The <code class="text-al-cyan">@afterlink/browser</code> package
          gives you the same API — no TCP required on the client side.
        </p>
      </div>

    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section id="how-it-works" class="py-24 px-4 sm:px-6 max-w-5xl mx-auto transition-colors border-t border-al-border">
    <div class="text-center mb-16 select-none">
      <p class="text-al-cyan font-mono text-xs font-bold uppercase tracking-widest mb-2">How It Works</p>
      <h2 class="text-2xl sm:text-3xl font-bold text-al-white font-mono">
        From connection to message in microseconds
      </h2>
    </div>

    <div class="hidden md:grid grid-cols-1 md:grid-cols-3 gap-8 relative items-start select-text">
      <!-- Connector line (desktop only) -->
      <div class="hidden md:block absolute top-12 left-[18%] right-[18%] h-px border-t border-dashed border-al-border select-none pointer-events-none"></div>

      <!-- Step 1 -->
      <div class="text-center flex flex-col items-center w-full max-w-sm px-4 mx-auto">
        <div class="w-16 h-16 rounded-xl bg-al-card border border-al-cyan mx-auto mb-6 flex items-center justify-center text-al-cyan font-mono font-bold text-lg shadow-[0_0_20px_rgba(0,216,255,0.08)] select-none">
          01
        </div>
        <h3 class="text-al-white font-mono font-semibold mb-2">TCP Connect</h3>
        <p class="text-al-muted text-xs leading-relaxed max-w-[260px] sm:max-w-xs select-all">
          Client opens a persistent TCP connection using
          <code class="text-al-cyan">afterlink://host:port</code>.
          One-time handshake — stays open for all future messages.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="text-center flex flex-col items-center w-full max-w-sm px-4 mx-auto">
        <div class="w-16 h-16 rounded-xl bg-al-card border border-al-cyan mx-auto mb-6 flex items-center justify-center text-al-cyan font-mono font-bold text-lg shadow-[0_0_20px_rgba(0,216,255,0.08)] select-none">
          02
        </div>
        <h3 class="text-al-white font-mono font-semibold mb-2">Binary Frame</h3>
        <p class="text-al-muted text-xs leading-relaxed max-w-[260px] sm:max-w-xs select-all">
          Every message is packed into a 10-byte binary header + MessagePack
          payload. Type byte routes the frame to the correct handler
          on the server — zero string parsing.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="text-center flex flex-col items-center w-full max-w-sm px-4 mx-auto">
        <div class="w-16 h-16 rounded-xl bg-al-card border border-al-cyan mx-auto mb-6 flex items-center justify-center text-al-cyan font-mono font-bold text-lg shadow-[0_0_20px_rgba(0,216,255,0.08)] select-none">
          03
        </div>
        <h3 class="text-al-white font-mono font-semibold mb-2">Route & Respond</h3>
        <p class="text-al-muted text-xs leading-relaxed max-w-[260px] sm:max-w-xs select-all">
          Server validates schema, runs middleware, calls your handler,
          and sends back a response frame. Pub/Sub events fan out
          to all subscribers on the channel automatically.
        </p>
      </div>
    </div>

    <!-- Mobile Bullet Points (Visible only on mobile screens) -->
    <div class="block md:hidden bg-al-card border border-al-border rounded-xl p-6 shadow-sm select-text my-8">
      <ul class="space-y-6 text-left font-mono text-xs text-al-text">
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 h-5 w-5 rounded bg-al-cyan/10 border border-al-cyan/35 text-al-cyan flex items-center justify-center font-bold">1</span>
          <div class="flex-1">
            <strong class="text-al-white block mb-0.5">TCP Connect</strong>
            <span class="text-al-muted leading-relaxed">Establish a persistent, reusable socket handshake via <code class="text-al-cyan">afterlink://</code> that stays open forever.</span>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 h-5 w-5 rounded bg-al-cyan/10 border border-al-cyan/35 text-al-cyan flex items-center justify-center font-bold">2</span>
          <div class="flex-1">
            <strong class="text-al-white block mb-0.5">Binary Header Packing</strong>
            <span class="text-al-muted leading-relaxed">Wrap every message in a lightweight 10-byte binary header with native MessagePack serialization.</span>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 h-5 w-5 rounded bg-al-cyan/10 border border-al-cyan/35 text-al-cyan flex items-center justify-center font-bold">3</span>
          <div class="flex-1">
            <strong class="text-al-white block mb-0.5">Route & Fan-out</strong>
            <span class="text-al-muted leading-relaxed">Trigger custom schema validations and broadcast immediate low-latency fan-out events to all subscribers.</span>
          </div>
        </li>
      </ul>
    </div>

    <!-- Diagram schematic (Desktop Only) -->
    <div class="hidden md:block bg-al-card border border-al-border rounded-xl p-6 font-mono text-xs overflow-x-auto shadow-sm select-all">
      <div class="flex items-center justify-between gap-4 min-w-[640px] text-center">
        <div class="flex-1">
          <div class="bg-al-bg border border-al-border rounded-lg p-3 text-al-white shadow-inner select-all">
            Client
          </div>
          <p class="text-[10px] text-al-muted mt-2 select-none">@afterlink/client</p>
        </div>
        <div class="text-al-cyan flex-1 text-center select-none">
          <div class="text-[10px] mb-1">connect()</div>
          <div>──────────────&gt;</div>
          <div class="text-[10px] mt-2 text-al-muted">10-byte frame</div>
        </div>
        <div class="flex-1">
          <div class="bg-al-bg border border-al-cyan rounded-lg p-3 text-al-cyan shadow-inner select-all">
            AfterLink Server
          </div>
          <p class="text-[10px] text-al-muted mt-2 select-none">@afterlink/server</p>
        </div>
        <div class="text-al-green flex-1 text-center select-none">
          <div class="text-[10px] mb-1">publish(channel)</div>
          <div>──────────────&gt;</div>
          <div class="text-[10px] mt-2 text-al-muted">fan-out</div>
        </div>
        <div class="flex-1">
          <div class="bg-al-bg border border-al-border rounded-lg p-3 text-al-white shadow-inner select-all">
            Subscribers
          </div>
          <p class="text-[10px] text-al-muted mt-2 select-none font-semibold">pub/sub clients</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== BENCHMARKS ===== -->
  <section id="benchmarks" class="py-24 px-4 sm:px-6 max-w-5xl mx-auto transition-colors border-t border-al-border">
    <div class="text-center mb-16 select-none">
      <p class="text-al-cyan font-mono text-xs font-bold uppercase tracking-widest mb-2">Performance</p>
      <h2 class="text-2xl sm:text-3xl font-bold text-al-white font-mono">
        Numbers that matter
      </h2>
      <p class="text-al-muted mt-3 text-xs leading-relaxed max-w-sm mx-auto">
        Benchmarked on Node.js 20, Apple M2, localhost — single connection.
      </p>
    </div>

    <!-- Big stats grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 mb-16 select-none">
