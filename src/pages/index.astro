<script>
  // Copy helper scripting
  const setupHeroCopy = (btnId: string, textId: string) => {
    const btn = document.getElementById(btnId);
    const textEl = document.getElementById(textId);
    
    if (btn && textEl) {
      btn.addEventListener('click', async () => {
        const text = textEl.textContent || '';
        const copySvg = btn.querySelector('.copy-svg');
        const checkSvg = btn.querySelector('.check-svg');
        const btnText = btn.querySelector('.btn-text');
        
        try {
          await navigator.clipboard.writeText(text);
          
          if (copySvg && checkSvg && btnText) {
            copySvg.classList.add('hidden');
            checkSvg.classList.remove('hidden');
            btnText.textContent = 'copied';
            
            btn.classList.add('text-al-green', 'border-al-green/40', 'bg-al-green/5');
            btn.classList.remove('text-al-muted');
            
            setTimeout(() => {
              copySvg.classList.remove('hidden');
              checkSvg.classList.add('hidden');
              btnText.textContent = 'copy';
              
              btn.classList.remove('text-al-green', 'border-al-green/40', 'bg-al-green/5');
              btn.classList.add('text-al-muted');
            }, 2000);
          }
        } catch (err) {
          console.error('Failed to copy command: ', err);
        }
      });
    }
  };

  setupHeroCopy('npm-btn-hero', 'npm-cmd');
  setupHeroCopy('skill-btn-hero', 'skill-cmd');
</script>
