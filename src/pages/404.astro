---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="404 Page Not Found — AfterLink">
  <Navbar />
  
  <div class="max-w-xl mx-auto px-4 sm:px-6 py-24 flex-1 flex flex-col justify-center text-center select-none relative">
    <!-- Center background glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[180px] bg-al-cyan/5 blur-[90px] rounded-full select-none pointer-events-none"></div>

    <!-- Glowing numeric block -->
    <div class="relative z-10">
      <h1 class="text-8xl sm:text-9xl font-mono font-bold text-al-cyan tracking-tighter drop-shadow-[0_0_30px_rgba(0,216,255,0.25)] select-none">
        404
      </h1>
      <h2 class="text-xl font-mono font-semibold text-al-white mt-6 mb-3">
        Page Not Found
      </h2>
      <p class="text-al-muted text-xs sm:text-sm leading-relaxed max-w-sm mx-auto mb-10">
        The page you are looking for does not exist, has been moved, or was removed. Check the URL or navigate using the routes below.
      </p>

      <!-- Action buttons -->
      <div class="flex flex-col sm:flex-row justify-center gap-4 max-w-xs sm:max-w-none mx-auto select-none">
        <a 
          href="/" 
          class="btn-primary w-full sm:w-auto inline-flex items-center justify-center rounded px-6 py-2.5 font-mono text-sm font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-al-cyan/50"
        >
          &larr; Go Home
        </a>
        <a 
          href="/docs" 
          class="w-full sm:w-auto inline-flex items-center justify-center rounded border border-al-border bg-al-card px-6 py-2.5 font-mono text-sm text-al-white hover:border-al-cyan/30 hover:bg-al-bg transition-all focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-al-cyan"
        >
          Documentation
        </a>
      </div>
    </div>
  </div>

  <Footer />
</BaseLayout>
