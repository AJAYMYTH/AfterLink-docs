---
// src/components/Footer.astro
---

<footer class="w-full border-t border-al-border bg-al-black/60 py-12 mt-auto">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Brand & Tagline -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left gap-1">
        <a href="/" class="font-mono text-sm font-bold text-al-white hover:text-al-cyan transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-al-cyan focus-visible:rounded px-1 py-0.5">
          AfterLink Docs<span class="text-al-cyan">●</span>
        </a>
        <p class="text-xs text-al-muted tracking-tight">
          Binary-precise. Real-time ready.
        </p>
      </div>

      <!-- Links -->
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-4 text-xs font-mono">
        <a href="/docs" class="text-al-muted hover:text-al-cyan transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-al-cyan focus-visible:rounded px-1.5 py-0.5">
          Docs
        </a>
        <a href="/changelog" class="text-al-muted hover:text-al-cyan transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-al-cyan focus-visible:rounded px-1.5 py-0.5">
          Changelog
        </a>
        <a href="https://github.com/AJAYMYTH/AfterLink" target="_blank" rel="noopener noreferrer" class="text-al-muted hover:text-al-cyan transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-al-cyan focus-visible:rounded px-1.5 py-0.5">
          GitHub ↗
        </a>
        <a href="https://github.com/AJAYMYTH/AfterLink/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="text-al-muted hover:text-al-cyan transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-al-cyan focus-visible:rounded px-1.5 py-0.5">
          License
        </a>
      </div>

      <!-- Copyright -->
      <div class="text-center md:text-right">
        <p class="text-2xs text-al-muted tracking-tight font-mono select-none">
          &copy; 2026 Javali Ajayakumar.
        </p>
        <p class="text-2xs text-al-muted/50 tracking-tight font-mono select-none">
          Released under the MIT License.
        </p>
      </div>

    </div>
  </div>
</footer>
