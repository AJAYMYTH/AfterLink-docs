---
// src/components/CodeBlock.astro
import { Code } from 'astro:components';

interface Props {
  code: string;
  lang?: any;
  filename?: string;
}

const { code, lang = 'javascript', filename } = Astro.props;
---

<div class="code-block group relative rounded-xl border border-al-border bg-zinc-50/80 dark:bg-[#09090b] overflow-hidden my-6 shadow-xs transition-colors">
  {filename && (
    <div class="flex items-center justify-between px-4 py-2.5 border-b border-al-border bg-zinc-100/50 dark:bg-al-card/30 font-mono text-2xs text-al-muted select-none">
      <span class="flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-al-cyan/70"></span>
        {filename}
      </span>
      <span class="text-3xs tracking-wider uppercase opacity-60 font-medium">{lang}</span>
    </div>
  )}
  <div class="relative">
    <div class="p-4 overflow-x-auto text-xs leading-relaxed font-mono select-all">
      <Code code={code.trim()} lang={lang} theme="github-dark" />
    </div>
    
    <!-- Copy button -->
    <button 
      class="code-copy-btn absolute top-3 right-3 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-all duration-200 rounded border border-al-border bg-al-card px-2.5 py-1.5 font-mono text-3xs text-al-muted hover:text-al-cyan hover:border-al-cyan/40 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-al-cyan cursor-pointer select-none"
      data-code={code.trim()}
      aria-label={`Copy code from ${filename || 'block'}`}
    >
      Copy
    </button>
  </div>
</div>

<script>
  // Select all copy buttons on page load
  const setupCopyButtons = () => {
    const copyButtons = document.querySelectorAll('.code-copy-btn');
    copyButtons.forEach(btn => {
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-code') || '';
        try {
          await navigator.clipboard.writeText(code);
          const originalText = btn.textContent;
          btn.textContent = 'Copied';
          btn.classList.add('text-al-green', 'border-al-green/50', 'bg-al-green/5');
          btn.classList.remove('text-al-muted');
          
          setTimeout(() => {
            btn.textContent = originalText;
            btn.classList.remove('text-al-green', 'border-al-green/50', 'bg-al-green/5');
            btn.classList.add('text-al-muted');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy code: ', err);
        }
      });
    });
  };

  // Run on load
  setupCopyButtons();
</script>

<style is:global>
  /* Shiki background overrides to blend in seamlessly with our Vercel style dark container */
  pre.shiki {
    background-color: transparent !important;
    margin: 0 !important;
    padding: 0 !important;
  }
</style>
