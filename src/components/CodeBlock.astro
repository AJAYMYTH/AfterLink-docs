---
// src/components/CodeBlock.astro
// Renders Shiki-highlighted HTML server-side, then hands it to the
// TerminalCard React island which handles the typewriter animation.
import { codeToHtml } from 'shiki';
import TerminalCard from './TerminalCard';

interface Props {
  code: string;
  lang?: string;
  filename?: string;
}

const { code, lang = 'javascript', filename } = Astro.props;

const trimmed = code.trim();

// Build Shiki-highlighted HTML on the server (zero client JS cost)
const highlightedHtml = await codeToHtml(trimmed, {
  lang: lang as string,
  themes: {
    dark:  'github-dark',
    light: 'github-light',
  },
  defaultColor: false,               // let CSS handle dark/light switching
});
---

<TerminalCard
  client:only="react"
  command={trimmed}
  filename={filename}
  language={String(lang)}
  highlightedHtml={highlightedHtml}
/>

<style is:global>
  /* ── Shiki dual-theme: variables are inline on every <span> ─────────── */

  /* Strip background & spacing Shiki sets inline on <pre> */
  .shiki-inject pre {
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    outline: none !important;
    margin: 0 !important;
    padding: 0 !important;
    font-size: inherit !important;
    line-height: 1.65 !important;
  }

  .shiki-inject code {
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    outline: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  /* Light mode – read the --shiki-light variable on each span */
  .shiki-inject span {
    color: var(--shiki-light) !important;
  }

  /* Dark mode – read the --shiki-dark variable on each span */
  .dark .shiki-inject span {
    color: var(--shiki-dark) !important;
  }

  /* Whole-line spans should not override the per-token colour */
  .shiki-inject .line {
    display: block;
  }
</style>
